<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_background"
    android:fitsSystemWindows="true">

    <!-- Top Web Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/md_theme_dark_primary"
        android:visibility="gone" />

    <!-- Incognito Top Banner (visible only in incognito mode) -->
    <LinearLayout
        android:id="@+id/banner_incognito"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/page_progress"
        android:background="#2E1C38"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_incognito" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Инкогнито: куки и история не сохраняются"
            android:textColor="@color/md_theme_dark_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_banner_exit_incognito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="✕ Закрыть всё"
            android:textColor="@color/md_theme_dark_on_primary_container"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/banner_incognito"
        android:layout_above="@+id/bottom_bar_card">

        <!-- Active Android WebView -->
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- MD3 Start Page Dashboard -->
        <ScrollView
            android:id="@+id/start_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/md_theme_dark_background">

            <LinearLayout
                android:id="@+id/start_page_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <!-- Logo & Badge -->
                <ImageView
                    android:id="@+id/img_app_logo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="LihonB"
                    android:textColor="@color/md_theme_dark_on_surface"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Быстрый веб без рекламы • Material 3"
                    android:textColor="@color/md_theme_dark_on_surface_variant"
                    android:textSize="13sp" />

                <!-- Prominent Big MD3 Search Bar with Engine Switcher -->
                <LinearLayout
                    android:id="@+id/big_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_search_large"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/tv_search_placeholder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Поиск в Google или веб-адрес"
                        android:textColor="@color/md_theme_dark_on_surface_variant"
                        android:textSize="15sp" />

                    <!-- Search Engine Selector Chip -->
                    <LinearLayout
                        android:id="@+id/btn_engine_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_omnibox"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/img_current_engine"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_engine_google" />

                        <TextView
                            android:id="@+id/tv_current_engine_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Google"
                            android:textColor="@color/md_theme_dark_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="▼"
                            android:textColor="@color/md_theme_dark_on_surface_variant"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Incognito Mode Toggle Button -->
                <LinearLayout
                    android:id="@+id/btn_toggle_incognito"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/img_incognito_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_incognito" />

                    <TextView
                        android:id="@+id/tv_incognito_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Перейти в режим Инкогнито"
                        android:textColor="@color/md_theme_dark_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- AdBlock Shield Card with Real Dynamic Visual States -->
                <LinearLayout
                    android:id="@+id/card_adblock_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card_adblock_on"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/img_adblock_shield"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_shield" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_adblock_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lihon AdBlock включён"
                            android:textColor="@color/md_theme_dark_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_adblock_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Блокирует баннеры, трекеры и рекламу"
                            android:textColor="@color/md_adblock_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Real On/Off Indicator Pill -->
                    <TextView
                        android:id="@+id/tv_adblock_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="ВКЛ"
                        android:textColor="@color/md_adblock_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Bar Floating Card -->
    <LinearLayout
        android:id="@+id/bottom_bar_card"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <!-- Home Button -->
        <ImageView
            android:id="@+id/btn_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_home" />

        <!-- Floating Omnibox Search Capsule -->
        <LinearLayout
            android:id="@+id/omnibox_capsule"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_omnibox"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/img_omnibox_status"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/tv_url_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Поиск или веб-адрес"
                android:textColor="@color/md_theme_dark_on_surface_variant"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <!-- Real Tabs Button -->
        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_tabs" />

            <TextView
                android:id="@+id/tv_tab_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:text="1"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- More Menu Button -->
        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_more" />

    </LinearLayout>

    <!-- Expandable Search / Input Sheet Overlay -->
    <LinearLayout
        android:id="@+id/search_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/md_theme_dark_surface_container"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_search_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri|textFilter"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/md_theme_dark_on_surface"
                android:textColorHint="@color/md_theme_dark_on_surface_variant"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_close_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Quick Engine Buttons in Overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_engine_google"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Google"
                android:textColor="@color/md_theme_dark_primary"
                android:background="@drawable/bg_omnibox"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_engine_yandex"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Yandex"
                android:textColor="@color/md_theme_dark_primary"
                android:background="@drawable/bg_omnibox"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_engine_duck"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="DuckDuckGo"
                android:textColor="@color/md_theme_dark_primary"
                android:background="@drawable/bg_omnibox"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
